{
  "name": "@repo/db",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dz:generate": "dotenv -e ../../apps/web/.env.local drizzle-kit generate --config=drizzle.config.ts",
    "dz:migrate": "dotenv -e ../../apps/web/.env.local drizzle-kit migrate --config=drizzle.config.ts",
    "dz:studio": "dotenv -e ../../apps/web/.env.local drizzle-kit studio --config=drizzle.config.ts",
    "dz:push": "dotenv -e ../../apps/web/.env.local drizzle-kit push --config=drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}