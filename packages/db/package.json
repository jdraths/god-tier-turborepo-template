{
  "name": "@repo/db",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dz:generate": "dotenv -e ../../apps/web/.env.local drizzle-kit generate --config=src/drizzle-dev.config.ts",
    "dz:migrate": "dotenv -e ../../apps/web/.env.local drizzle-kit migrate --config=src/drizzle-dev.config.ts",
    "dz:studio": "dotenv -e ../../apps/web/.env.local drizzle-kit studio --config=src/drizzle-dev.config.ts",
    "dz:push": "dotenv -e ../../apps/web/.env.local drizzle-kit push --config=src/drizzle-dev.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.6",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3"
  }
}